#!/bin/sh
# The maintainer's pre-push hook for the Engine repo: refuses a push whose commits carry a name from
# the deny list of the maintainer's own Log (maintainer/prepush.py). Installed with
# `git config core.hooksPath maintainer/hooks` (docs/maintaining.md › The pre-push check); a
# contributor without that list does not install it. Fails closed: no Python 3.11+, no configured
# deny list or no file there refuses the push.
HERE=$(dirname "$0")
for py in python3 python "py -3"; do
  # shellcheck disable=SC2086
  if $py -I -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    exec $py -I "$HERE/../prepush.py" hook "$@"
  fi
done
echo "FAIL: pre-push: no Python 3.11 or newer found (python3, python or py -3), so the push is refused" >&2
exit 1
